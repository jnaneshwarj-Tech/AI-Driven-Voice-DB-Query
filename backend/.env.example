# ============================================================
# AI Database Automator — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit .env to version control!

# ── MySQL Database ──────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=student_db

# ── Application Security ────────────────────────────────────
SECRET_KEY=your_long_random_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1000

# ── Application Identity ────────────────────────────────────
APP_NAME=AI Database Automator

# ── AI / LLM Configuration ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ── Email / SMTP Settings (Required for Password Reset) ─────
# Gmail SMTP Configuration:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Gmail App Password (NOT your regular Gmail password):
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate a new App Password for "Mail"
# 4. Use the 16-character password below (no spaces)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password_here

# Email sender configuration:
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=AI Database Automator

# ── OTP / Password Reset Settings ───────────────────────────
OTP_EXPIRY_SECONDS=120              # OTP valid for 2 minutes
OTP_RESEND_COOLDOWN_SECONDS=30      # 30-second cooldown between OTP requests
OTP_MAX_ATTEMPTS=5                  # Max wrong OTP attempts before lock
RESET_TOKEN_EXPIRY_MINUTES=10       # Reset token valid for 10 minutes after OTP
OTP_MAX_REQUESTS_PER_HOUR=5         # Rate limit: max 5 OTP requests per email/hour

# ── Frontend URL ────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Backup / Recovery Settings ──────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_AUTO_ENABLED=true

# ── Upload Settings ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_ROWS_PER_CHUNK=500

# ── Undo / Restore Settings ─────────────────────────────────
UNDO_WINDOW_MINUTES_SINGLE=5
UNDO_WINDOW_MINUTES_BULK=30
UNDO_RETENTION_DAYS=30

# ============================================================
# IMPORTANT NOTES:
# ============================================================
#
# 1. Gmail App Passwords:
#    - Regular Gmail passwords will NOT work for SMTP
#    - You MUST create an App Password:
#      a) Enable 2-Step Verification on your Google Account
#      b) Visit: https://myaccount.google.com/apppasswords
#      c) Generate password for "Mail"
#      d) Use the 16-character code (no spaces)
#
# 2. Other Email Providers:
#    - For Outlook/Hotmail: Use smtp-mail.outlook.com on port 587
#    - For Yahoo: Use smtp.mail.yahoo.com on port 587
#    - For custom SMTP: Update MAIL_SERVER and MAIL_PORT accordingly
#
# 3. Development Mode:
#    - If MAIL_USERNAME/MAIL_PASSWORD are empty, OTP will print to console
#    - This is ONLY for local development/testing
#    - NEVER deploy to production without configuring real email
#
# 4. Security:
#    - Keep this file private
#    - Never commit to Git
#    - Use strong, unique SECRET_KEY
#    - Rotate credentials regularly
#
# ============================================================
