# ==============================================================================
# AI-Driven College Student Database Management System — Root Environment Template
# ==============================================================================
# Copy this file to `backend/.env` for backend services.
# NEVER commit real `.env` files containing credentials to version control!

# ── MySQL Central Database (Required) ─────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=student_admin
MYSQL_PASSWORD=replace_with_strong_password
MYSQL_DB=student_db

# ── Application Security & JWT Authentication (Required) ──────────────────────
# Generate a secure 64-character secret using: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_cryptographic_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI / LLM Configuration (Optional: fallback rules apply if empty) ──────────
# Supports Google Gemini (https://aistudio.google.com/apikey) or NVIDIA NIM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ── Server & Network Binding (Required) ───────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Email / SMTP Settings (Optional: printed to console in DEV mode) ───────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=college_erp@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=college_erp@gmail.com
MAIL_FROM_NAME="GEC Student Database ERP"

# ── OTP & Password Reset Policy ───────────────────────────────────────────────
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRY_MINUTES=10
OTP_MAX_REQUESTS_PER_HOUR=5

# ── File Storage & Automated Backups ──────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_AUTO_ENABLED=true
UPLOAD_DIR=uploads
MAX_UPLOAD_ROWS_PER_CHUNK=500
UNDO_WINDOW_MINUTES_SINGLE=5
UNDO_WINDOW_MINUTES_BULK=30
UNDO_RETENTION_DAYS=30
