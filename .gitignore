# ============================================================
# Git Ignore Rules — AI-Driven College Student Database ERP
# ============================================================

# ── Environment Variables & Secrets ───────────────────────────
.env
.env.*
*.env
backend/.env
backend/.env.*
desktop/.env
desktop/.env.*
!**/.env.example

# ── Dependencies & Package Managers ───────────────────────────
node_modules/
*/node_modules/
frontend/node_modules/
desktop/node_modules/
package-lock.json.backup
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python & Virtual Environments ─────────────────────────────
__pycache__/
*/__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
*/.venv/
venv/
*/venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# ── Production Web & Desktop Build Outputs ────────────────────
dist/
build/
frontend/dist/
frontend/build/
dist-electron/
release/
out/
bin/
*.exe
*.msi
*.zip
*.tar.gz

# ── Database Dumps & Backups ──────────────────────────────────
# Preserve directory structure with .gitkeep; ignore all actual dump files
backend/backups/*.sql
backend/backups/*.sql.gz
backups/*.sql
backups/*.sql.gz
*.dump
*.sql.bak

# ── Uploads & Generated Student Files ─────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep
exports/*.xlsx
exports/*.csv
exports/*.pdf
*.xlsx.bak

# ── Screenshots & Temporary Test Caches ───────────────────────
_qa_checkpoints/
*.json.bak
_*.json
*_results.json
frontend/shot_*.png

# ── Application Logs & Diagnostics ────────────────────────────
*.log
backend/*.log
logs/
*.pid

# ── IDE & Local Machine Configuration ─────────────────────────
.vscode/
.idea/
.trae/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
